# ---- Vulnerability ledger (SQLite, runtime artifact) ----
data/*.db
data/*.sqlite3
*.db
*.sqlite3
# SQLite sidecar files (rollback journal / WAL / shared-memory) — transient, never commit
*.db-journal
*.db-wal
*.db-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite

# ---- deploy.sh runtime (logs + pidfiles) ----
.run/

