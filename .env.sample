# AI DevSecBuddy — environment template (committed; no secrets).
# Copy to .env and fill in the secret(s):  cp .env.sample .env
# .env is gitignored; deploy.sh auto-loads it (set -a; . ./.env; set +a). To run
# uvicorn directly, source it the same way first so the engine sees these values.

# ── Secret — leave blank to fall back to the offline mock engine ──
# Anthropic API key (Claude). Get one: docs/setup/anthropic-signup.md
ANTHROPIC_API_KEY=

# Default engine the backend runs (mock | anthropic | vertex).
# mock = offline + free + deterministic; anthropic = Claude; vertex = Gemini on GCP.
DEVSECBUDDY_ENGINE=vertex

# ── Anthropic — Claude, called directly against the Anthropic API ──
# Default model; selectable per run in the UI. Tiers (low → high cost):
#   low  claude-haiku-4-5   ·   mid  claude-sonnet-4-6   ·   high  claude-opus-4-8
DEVSECBUDDY_ANTHROPIC_MODEL=claude-haiku-4-5

# ── Google Vertex AI — Gemini models, via GCP ──
#   Authenticate once as your user (writes Application Default Credentials):
#     gcloud auth application-default login
#   then enable the Vertex AI API on the project and grant your account
#   roles/aiplatform.user.  See docs/setup/google-vertex-signup.md.
DEVSECBUDDY_VERTEX_PROJECT=devsecbuddy
DEVSECBUDDY_VERTEX_PROJECT_NUMBER=595277113347   # informational; the SDK uses the project ID above
DEVSECBUDDY_VERTEX_REGION=us-east1
# Default model; selectable per run in the UI. Tiers (low → high cost):
#   low  gemini-2.5-flash-lite   ·   mid  gemini-2.5-flash   ·   high  gemini-2.5-pro
DEVSECBUDDY_VERTEX_MODEL=gemini-2.5-flash
#   ^ If a run returns NOT_FOUND for the model, it isn't served from this region —
#     switch DEVSECBUDDY_VERTEX_REGION to us-central1 or global.

# ── Optional ──
# DEVSECBUDDY_DB=data/ledger.db                 # SQLite ledger path
# DEVSECBUDDY_CORS_ORIGINS=http://localhost:5173
